{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourownweigh.example/contracts/backup/v1",
  "title": "YourOwnWeigh Household Backup v1",
  "description": "Envelope validation; exact columns, foreign keys and semantic limits are validated by server/ts/backup.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "sections",
    "accessSettings"
  ],
  "properties": {
    "format": {
      "const": "YOW-backup-v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "users",
        "scales",
        "scale_users",
        "readings",
        "health_sync_receipts",
        "reviewed_captures",
        "events",
        "sync_audit",
        "measure_attempts",
        "measure_rejections"
      ],
      "properties": {
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "scales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "scale_users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "health_sync_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "reviewed_captures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "sync_audit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "measure_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "measure_rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    },
    "accessSettings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "enum": [
              "admin_password",
              "api_password",
              "sync_password_mode"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "null"
        ]
      }
    }
  }
}
