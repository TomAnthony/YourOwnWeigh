# Copy to .env and edit. One subdomain serves both the dashboard and the scale.
TZ=Europe/Berlin

# The external HTTPS origin your reverse proxy serves (dashboard + scale).
YOW_PUBLIC_ORIGIN=https://waage.example.com

# Optional first-run bootstrap token (>=24 chars). Omit to use the token the
# server writes to /data/bootstrap-token.txt on first start (read it with
# `docker logs yourownweigh` or from the data volume).
# YOW_BOOTSTRAP_TOKEN=change-me-to-a-long-random-string
